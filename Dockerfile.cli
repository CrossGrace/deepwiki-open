# Dockerfile for DeepWiki Single Provider CLI
# This is a lightweight version for running deepwiki_single.py only

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    ca-certificates \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements_single.txt .
RUN pip install --no-cache-dir -r requirements_single.txt

# Copy application code
COPY api/ ./api/
COPY deepwiki_single.py .

# Create directories for output and workspace
RUN mkdir -p /app/output /app/workspace /app/logs

# Set environment variables with defaults
ENV DEEPWIKI_WORKSPACE=/app/workspace
ENV DEEPWIKI_OUTPUT=/app/output

# Expose no ports (CLI only)

# Set entrypoint to Python
ENTRYPOINT ["python", "deepwiki_single.py"]

# Default command shows help
CMD ["--help"]
