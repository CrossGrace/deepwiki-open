# DeepWiki-Open Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: LLM API Configuration (gpt-oss-130b)
# =============================================================================
# Base URL for the GPT-OSS-130b API (OpenAI-compatible endpoint)
DEEPWIKI_LLM_BASE_URL=https://your-llm-api.company.com

# Authentication token for LLM API (sent as x-dep-ticket header)
DEEPWIKI_LLM_TOKEN=your-llm-auth-token


# =============================================================================
# REQUIRED: Embedding API Configuration (BGE-M3)
# =============================================================================
# Base URL for the BGE-M3 embedding API
DEEPWIKI_EMBEDDING_BASE_URL=https://your-embedding-api.company.com

# Authentication token for embedding API (sent as x-dep-ticket header)
DEEPWIKI_EMBEDDING_TOKEN=your-embedding-auth-token


# =============================================================================
# OPTIONAL: Application Configuration
# =============================================================================
# Workspace directory for cloning repositories (default: ./workspace)
DEEPWIKI_WORKSPACE=./workspace

# Default output directory for generated wikis (default: ./wiki_output)
DEEPWIKI_OUTPUT=./wiki_output


# =============================================================================
# WEB APPLICATION CONFIGURATION (if using web UI)
# =============================================================================
# Backend API port (default: 8001)
PORT=8001

# Node environment (production or development)
NODE_ENV=production

# Server base URL for API
SERVER_BASE_URL=http://localhost:8001

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE_PATH=api/logs/application.log


# =============================================================================
# OPTIONAL: OpenAI/Google API Keys (for multi-provider mode)
# =============================================================================
# Note: These are only needed if using the full multi-provider version
# For single-provider mode (deepwiki_single.py), only the above LLM/Embedding configs are needed

# OpenAI API key (optional, for multi-provider mode)
OPENAI_API_KEY=

# Google API key (optional, for multi-provider mode)
GOOGLE_API_KEY=


# =============================================================================
# GITHUB ACCESS (for private repositories)
# =============================================================================
# GitHub personal access token (optional, only needed for private repos)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=


# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# Memory limit for Docker container (default: 6g)
DOCKER_MEMORY_LIMIT=6g

# Memory reservation for Docker container (default: 2g)
DOCKER_MEMORY_RESERVATION=2g
